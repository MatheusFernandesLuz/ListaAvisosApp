<Window x:Class="ListaAvisosApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lista de Avisos Diversos" Height="600" Width="1280"
        WindowStartupLocation="CenterScreen" Icon="/icon.ico">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="BtnAtualizar" Content="Atualizar dados" Padding="15,8" Click="BtnAtualizar_Click"/>
            <Button x:Name="BtnGerar" Content="Gerar / Imprimir Relatório" Padding="15,8" Margin="10,0,0,0"
                    Click="BtnGerar_Click" IsEnabled="False"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <DataGrid x:Name="GridEventos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,17,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEvento}" Width="150"/>
                <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="70"/>
                <DataGridTextColumn Header="Dia" Binding="{Binding Dia}" Width="70"/>
                <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="120"/>
                <DataGridTextColumn Header="Assunto" Binding="{Binding Assunto}" Width="300"/>
                <DataGridTextColumn Header="Endereco" Binding="{Binding Endereco}" Width="800"/>
                <DataGridTextColumn Header="Atendimento" Binding="{Binding Atendimento}" Width="150"/>
                <DataGridTextColumn Header="Descricao Aviso" Binding="{Binding Descricao}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="DarkRed" TextWrapping="Wrap" x:Name="TxtErro"/>
        <TextBlock x:Name="TxtAviso" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Height="35" Text=""/>
    </Grid>
</Window>
